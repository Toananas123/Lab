rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // User scope: all collections are strictly partitioned per authenticated user
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Profile
      match /profile/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      // User Custom Exercises
      match /exercises/{exerciseId} {
        allow read, write: if isOwner(userId) && isValidId(exerciseId);
      }

      // User Favorites
      match /favorites/{favId} {
        allow read, write: if isOwner(userId) && isValidId(favId);
      }

      // User Routines
      match /routines/{routineId} {
        allow read, write: if isOwner(userId) && isValidId(routineId);
      }

      // User Workouts & Set Logs
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId) && isValidId(workoutId);
      }

      // User Physical Measurements
      match /measurements/{measurementId} {
        allow read, write: if isOwner(userId) && isValidId(measurementId);
      }

      // User Weekly Plans
      match /weekly_plans/{planId} {
        allow read, write: if isOwner(userId) && isValidId(planId);
      }
    }
  }
}
